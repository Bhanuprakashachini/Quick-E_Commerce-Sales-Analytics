{
  "name": "Custom Theme",
  "dataColors": [
    "#47cee0",
    "#a95995",
    "#e6bbb9",
    "#e1c7ab",
    "#917f16"
  ],
  "foreground": "#111827",
  "background": "#ffffff",
  "foregroundNeutralSecondary": "#6b7280",
  "backgroundLight": "#daf5f9",
  "foregroundNeutralTertiary": "#6b7280",
  "backgroundNeutral": "#ffffff",
  "tableAccent": "#47cee0",
  "maximum": "#e6bbb9",
  "center": "#a95995",
  "minimum": "#47cee0",
  "bad": "#47cee0",
  "neutral": "#a95995",
  "good": "#e6bbb9",
  "textClasses": {
    "callout": {
      "color": "#111827",
      "fontFace": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif"
    },
    "title": {
      "color": "#111827",
      "fontFace": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif"
    },
    "header": {
      "color": "#111827",
      "fontFace": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif"
    },
    "label": {
      "color": "#111827",
      "fontFace": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#ffffff"
              }
            }
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "show": true,
            "radius": 4
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "border": {
              "solid": {
                "color": "#ffffff"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#daf5f9"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#000000"
              }
            }
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "transparency": 0
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#ececec"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 0
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}